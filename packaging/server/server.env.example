# Copy this file to /etc/cmdb-lite/server.env, replace the value, and restrict
# ownership before starting cmdb-server:
#
#   install -o root -g root -m 0600 server.env.example /etc/cmdb-lite/server.env
#
# Use a long, unique database passphrase. Do not reuse a user account password.
# The server unsets this variable after reading it. The passphrase cannot be
# recovered if lost; keep it with your offline backups.
CMDB_DB_PASSPHRASE=replace-with-a-long-random-database-passphrase
