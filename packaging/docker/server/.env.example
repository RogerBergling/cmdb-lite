# Copy this file to packaging/docker/server/.env and adjust it.
# Do not put the database passphrase here; use the secret file described in
# README.md.

# Host-side bind address and port. The container always listens on 8080.
# Keep 127.0.0.1 when the external TLS proxy runs on the same host.
CMDB_HTTP_BIND=127.0.0.1
CMDB_HTTP_PORT=8080

# Trusted proxy source CIDR as seen by the container. The default covers
# Docker bridge networks. Narrow it to the exact proxy address/network, or set
# the public proxy address if the proxy is on another host.
CMDB_PROXY=172.16.0.0/12

# Session and agent retention settings.
CMDB_SESSION_IDLE=30m
CMDB_SESSION_ABSOLUTE=12h
CMDB_AGENT_INTERVAL=24h
CMDB_AGENT_RETENTION_DAYS=365
CMDB_AGENT_REPORTS_PER_HOST=90
