{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMDB_BUILD_UI": "ON",
        "CMDB_BUILD_TESTS": "ON",
        "CMDB_WERROR": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug with ASan/UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMDB_BUILD_UI": "ON",
        "CMDB_BUILD_TESTS": "ON",
        "CMDB_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "core",
      "displayName": "Core only (headless)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMDB_BUILD_UI": "OFF",
        "CMDB_BUILD_TESTS": "ON",
        "CMDB_WERROR": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMDB_BUILD_UI": "ON",
        "CMDB_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows MSVC x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-windows",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMDB_BUILD_UI": "ON",
        "CMDB_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "core", "configurePreset": "core" },
    { "name": "release", "configurePreset": "release" },
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "core", "configurePreset": "core", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "windows", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
